{
  "compilerOptions": {
    "target": "ES2023",
    // Playwright's `page.evaluate` callbacks execute in the renderer, so these
    // files legitimately need both the Node and the DOM lib.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",

    // TypeScript 7 removed `baseUrl`; path patterns are relative to this file.
    "paths": {
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["tests/e2e/**/*.ts", "src/shared/**/*.ts", "playwright.config.ts"]
}
