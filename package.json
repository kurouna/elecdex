{
  "name": "elecdex",
  "productName": "elecdex",
  "version": "0.0.1",
  "private": true,
  "description": "A science-fiction desktop terminal emulator and system monitor. A modern rewrite of eDEX-UI.",
  "keywords": [
    "terminal",
    "tty",
    "system-monitor",
    "sci-fi",
    "electron",
    "svelte"
  ],
  "homepage": "https://github.com/kurouna/elecdex",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kurouna/elecdex.git"
  },
  "bugs": {
    "url": "https://github.com/kurouna/elecdex/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "npm run typecheck:node && npm run typecheck:e2e && npm run typecheck:web",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "svelte-check --tsconfig tsconfig.web.json --threshold warning",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "package": "electron-vite build && electron-builder",
    "package:dir": "electron-vite build && electron-builder --dir",
    "postinstall": "electron-builder install-app-deps",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "gen:icon": "node scripts/gen-icon.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/chakra-petch": "5.3.0",
    "@fontsource/saira-condensed": "5.3.0",
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "24.13.4",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "electron-playwright-helpers": "3.1.2",
    "electron-vite": "5.0.0",
    "jsdom": "30.0.1",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.0"
  },
  "dependencies": {},
  "author": {
    "name": "kurouna",
    "url": "https://github.com/kurouna"
  }
}
