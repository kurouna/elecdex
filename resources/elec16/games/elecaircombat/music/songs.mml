# ELECAIRCOMBAT's music (docs/elec16-elecaircombat.md section 8), for the game kit's MML
# (docs/elec16-play.md section 10). Channels 0-11 are the music's; 12-15 the effects'.
# Sharps are written with + (a # starts a comment).
#
# The band in every song:
#   C0 lead, C1 its echo, C2 harmony, C3 bass, C4 arpeggio, C5 kick, C6 snare, C7 hats
#
# The music sits under the effects (2026-10-10, the user: the music drowned the gun, the
# seeker and the warnings): every instrument's vol= is 0.45 of what it was written at (about
# -7 dB, the channels' balance kept), and the effects in sfx.mml are as they were.

# ----------------------------------------------------------------------------------------
song title
# Heroic and wide: D major, a sixteenth is seven frames (about 129 BPM). Brass-like lead over
# a striding bass; the second half climbs through B minor to a long A.
tempo 7
inst lead  wave=sq50 vol=6 env=10/300/10/200 vib=3,5 pan=6
inst harm  wave=sq25 vol=3  env=40/400/9/300 pan=10
inst bass  wave=saw  vol=5 env=2/150/8/60
inst arp   wave=tri  vol=4  env=2/80/3/40 pan=11
inst kick  wave=tri  vol=7 env=0/120/0/40 drop=2
inst snare wave=noise vol=5 env=0/180/0/140 pan=7
inst hat   wave=noise vol=2 env=0/20/0/20 pan=9

define bD  = l8 [o2 d d > d < d]2
define bA  = l8 [o2 a a > a < a]2
define bB  = l8 [o2 b b > b < b]2
define bG  = l8 [o2 g g > g < g]2
define bE  = l8 [o2 e e > e < e]2
define aD  = l16 [o4 d f+ a > d <]4
define aA  = l16 [o4 c+ e a > c+ <]4
define aB  = l16 [o4 d f+ b > d <]4
define aG  = l16 [o4 d g b > d <]4
define aE  = l16 [o4 e g b > e <]4
define kick  = o4 c8 r8 r4 c8 c8 r4
define snare = r4 o7 c4 r4 c4
define fill  = r4 o7 c4 r8 c16 c16 c8 c8
define hats  = [o9 c8]8

C0: @lead v13 L o5 d4. e8 f+4 a4 | o5 e2. c+4 | o5 d4. c+8 o4 b4 o5 d4 | o4 b2 g4 o5 d4
C0: o5 a4. g8 f+4 e8 f+8 | o5 e2 r4 c+8 e8 | o5 d4. e8 f+4 g4 | o5 a1
C0: o5 f+4. e8 d4 f+4 | o5 g4. f+8 e4 d4 | o5 f+4. e8 d4 a4 | o5 e2. r4
C0: o5 f+4 a4 o6 d4 c+8 o5 b8 | o6 d2 o5 b4 g4 | o5 e4 g4 b4 o6 e4 | o6 c+2 e2
C2: @harm v9 L o4 f+1 | e1 | f+1 | d1 | f+1 | e1 | d1 | c+1 | d1 | d1 | f+1 | e1 | d1 | d1 | e1 | e1
C3: @bass v12 L $bD $bA $bB $bG $bD $bA $bG $bA $bB $bG $bD $bA $bB $bG $bE $bA
C4: @arp v7 L $aD $aA $aB $aG $aD $aA $aG $aA $aB $aG $aD $aA $aB $aG $aE $aA
C5: @kick L [$kick]16
C6: @snare L [$snare]7 $fill [$snare]7 $fill
C7: @hat L [$hats]16

echo C1 = C0 delay 14 vol -6 pan 11

# ----------------------------------------------------------------------------------------
song brief
# The briefing: calm and watchful, A minor, a sixteenth is eight frames (112 BPM).
tempo 8
inst pad  wave=sq25 vol=4 env=80/600/9/400 vib=2,4 pan=6
inst bass wave=tri  vol=5 env=4/200/8/100
inst arp  wave=tri  vol=3 env=2/120/2/80 pan=11
inst tick wave=noise vol=1 env=0/20/0/20 pan=9

C2: @pad v10 L o4 a1 | f1 | c1 | e1 | a1 | f1 | g1 | e1
C3: @bass v11 L l4 o2 a > a < a > a < | f > f < f > f < | c > c < c > c < | e > e < e > e < | a > a < a > a < | f > f < f > f < | g > g < g > g < | e > e < e > e <
C4: @arp v6 L l16 [o4 a > c e < b]4 [o4 a > c f c <]4 [o4 g > c e c <]4 [o4 g+ b > e < b]4 [o4 a > c e < b]4 [o4 a > c f c <]4 [o4 g b > d < b]4 [o4 g+ b > e < b]4
C7: @tick L [o9 c4]32

# ----------------------------------------------------------------------------------------
song fight
# The dogfight: D minor, tense and driving, a sixteenth is six frames (150 BPM). A bass that
# never rests, a lead of short stabs; the second half lifts to a D major chord and falls.
tempo 6
inst lead  wave=sq25 vol=6 env=2/180/9/100 vib=2,6 pan=5
inst harm  wave=sq50 vol=3  env=4/200/8/120 pan=10
inst bass  wave=saw  vol=5 env=0/90/9/30
inst arp   wave=tri  vol=4  env=0/60/2/30 pan=11
inst kick  wave=tri  vol=7 env=0/120/0/40 drop=2
inst snare wave=noise vol=5 env=0/160/0/120 pan=7
inst hat   wave=noise vol=2 env=0/20/0/20 pan=9

define bD  = l16 [o2 d d > d < d]4
define bBb = l16 [o2 b- b- > b- < b-]4
define bC  = l16 [o3 c c > c < c]4
define bG  = l16 [o2 g g > g < g]4
define bA  = l16 [o2 a a > a < a]4
define aDm = l16 [o4 d f a > d <]4
define aBb = l16 [o4 d f b- > d <]4
define aC  = l16 [o4 c e g > c <]4
define aGm = l16 [o4 d g b- > d <]4
define aA  = l16 [o4 c+ e a > c+ <]4
define aD  = l16 [o4 d f+ a > d <]4
define kick  = o4 c16 r16 c16 r16 r4 c16 r16 r8 c16 r16 c16 r16
define snare = r4 o7 c4 r4 c4
define fill  = r4 o7 c8 c8 c16 c16 c16 c16 c16 c16 c16 c16
define hats  = [o9 c16 r16]8

C0: @lead v13 L o5 d8 r16 d16 f8 a8 g8 f8 e8 c8 | o5 d4 r8 a8 o6 c8 o5 a8 g8 e8
C0: o5 f8 r16 f16 g8 b-8 a8 g8 f8 d8 | o5 e2 g4 c4
C0: o5 d8 r16 d16 f8 a8 o6 d8 c8 o5 a8 f8 | o5 g4. f8 e4 c+4
C0: o5 d8 r16 d16 g8 b-8 o6 d4 c8 o5 b-8 | o5 a2 c+4 e4
C0: o6 d4. c8 o5 b-4 a4 | o6 c4. o5 b-8 a4 g4 | o5 a4. g8 f4 a4 | o5 e2. r4
C0: o5 f8 g8 a8 b-8 o6 c8 d8 e8 f8 | o6 g4 e4 c4 o5 g4 | o5 f+2 a2 | o5 a8 g8 f8 e8 d8 c+8 o4 b8 a8
C2: @harm v8 L o4 a1 | a1 | b-1 | g1 | a1 | b-1 | b-1 | a1 | f1 | g1 | f1 | e1 | f1 | g1 | f+1 | e1
C3: @bass v12 L $bD $bD $bBb $bC $bD $bD $bG $bA $bBb $bC $bD $bA $bBb $bC $bD $bA
C4: @arp v7 L $aDm $aDm $aBb $aC $aDm $aDm $aGm $aA $aBb $aC $aDm $aA $aBb $aC $aD $aA
C5: @kick L [$kick]16
C6: @snare L [$snare]7 $fill [$snare]7 $fill
C7: @hat L [$hats]16

echo C1 = C0 delay 9 vol -6 pan 11

# ----------------------------------------------------------------------------------------
song final
# The last ace: C minor at 180 BPM (a sixteenth is five frames), the Neapolitan D-flat
# darkening the turn back to G.
tempo 5
inst lead  wave=sq25 vol=6 env=2/160/9/90 vib=3,7 pan=5
inst harm  wave=sq50 vol=4  env=0/90/5/60 pan=10
inst bass  wave=saw  vol=6 env=0/80/9/30
inst arp   wave=tri  vol=4  env=0/60/2/30 pan=11
inst kick  wave=tri  vol=7 env=0/120/0/40 drop=2
inst snare wave=noise vol=5 env=0/160/0/120 pan=7
inst hat   wave=noise vol=2 env=0/20/0/20 pan=9

define bC  = l16 [o2 c c > c < c]4
define bAb = l16 [o2 a- a- > a- < a-]4
define bF  = l16 [o2 f f > f < f]4
define bG  = l16 [o2 g g > g < g]4
define bDb = l16 [o2 d- d- > d- < d-]4
define aCm = l16 [o4 c e- g > c <]4
define aAb = l16 [o4 c e- a- > c <]4
define aF  = l16 [o4 c f a- > c <]4
define aG  = l16 [o4 d g b > d <]4
define aDb = l16 [o4 d- f a- > d- <]4
define kick  = o4 c16 r16 c16 r16 r4 c16 r16 c16 r16 r4
define snare = r4 o7 c4 r4 c4
define fill  = r4 o7 c8 c8 c16 c16 c16 c16 c16 c16 c16 c16
define hats  = [o9 c16]16

C0: @lead v13 L o5 c8 c16 c16 e-8 g8 o6 c8 o5 b-8 g8 e-8 | o5 a-4 g8 f8 e-4 c4
C0: o5 f8 f16 f16 a-8 o6 c8 f8 e-8 c8 o5 a-8 | o5 g2 b4 o6 d4
C0: o6 c4. o5 b-8 g4 e-4 | o5 a-8 b-8 o6 c8 e-8 d8 c8 o5 b-8 a-8 | o5 a-4 f4 d-4 f4 | o5 g8 a-8 b8 o6 c8 d8 e-8 f8 g8
C2: @harm v8 L l8 [o4 g r g r e- r e- r]2 [o4 a- r a- r f r f r]2 [o4 g r g r e- r e- r]1 [o4 a- r a- r f r f r]1 [o4 f r f r d- r d- r]1 [o4 g r g r b r b r]1
C3: @bass v13 L $bC $bAb $bF $bG $bC $bAb $bDb $bG
C4: @arp v7 L $aCm $aAb $aF $aG $aCm $aAb $aDb $aG
C5: @kick L [$kick]8
C6: @snare L [$snare]3 $fill [$snare]3 $fill
C7: @hat L [$hats]8

echo C1 = C0 delay 10 vol -6 pan 11

# ----------------------------------------------------------------------------------------
song win
# The ace down: a fanfare that lands on D major and rings.
tempo 6
inst lead wave=sq50 vol=6 env=4/300/10/400 vib=3,5 pan=6
inst harm wave=sq25 vol=4 env=4/300/9/400 pan=10
inst bass wave=saw vol=5 env=2/200/8/300
inst kick wave=tri vol=7 env=0/120/0/40 drop=2
C0: @lead v13 o5 a8 a16 a16 a8 f+8 o6 d4. c+8 | o5 b8 b16 b16 b8 g8 o6 e4. d8 | o6 c+8 d8 e8 f+8 e4 c+4 | o6 d1
C2: @harm v9 o5 f+4. d8 a4. a8 | o5 g4. d8 b4. b8 | o5 a4 a4 a4 g4 | o5 f+1
C3: @bass v11 o2 d4. d8 d4. d8 | o2 g4. g8 g4. g8 | o2 a4 a4 a4 a4 | o2 d1
C5: @kick o4 c4 c4 c4 c4 | c4 c4 c4 c4 | c8 c8 c8 c8 c8 c8 c8 c8 | c1

# ----------------------------------------------------------------------------------------
song over
# Shot down: a falling line in D minor that fades.
tempo 7
inst lead wave=sq25 vol=5 env=10/400/8/600 vib=4,4 pan=6
inst bass wave=tri vol=5 env=10/600/6/800
C0: @lead v12 o5 a4 g4 f4 e4 | o5 d2 c+4 e4 | o5 d1
C3: @bass v11 o3 d2 o2 b-2 | o2 a1 | o2 d1

# ----------------------------------------------------------------------------------------
song ending
# Every ace down, and the name for the best five: D major, slow and open.
tempo 8
inst lead wave=sq50 vol=5 env=30/500/9/400 vib=3,4 pan=6
inst harm wave=tri  vol=4  env=40/600/9/400 pan=10
inst bass wave=tri  vol=5 env=4/300/8/200
inst arp  wave=tri  vol=3  env=2/100/2/60 pan=11

C0: @lead v11 L o5 f+2 a2 | o5 g2. f+8 e8 | o5 f+2 d2 | o5 e1 | o5 d4 f+4 a4 o6 d4 | o6 c+2 o5 b4 a4 | o5 g4 b4 a4 g4 | o5 f+1
C2: @harm v8 L o4 a1 | b1 | a1 | a1 | f+1 | e1 | d1 | d1
C3: @bass v11 L o2 d1 | g1 | d1 | a1 | b1 | a1 | g1 | d1
C4: @arp v6 L l16 [o4 d f+ a > d <]4 [o4 d g b > d <]4 [o4 d f+ a > d <]4 [o4 c+ e a > c+ <]4 [o4 d f+ b > d <]4 [o4 c+ e a > c+ <]4 [o4 d g b > d <]4 [o4 d f+ a > d <]4
