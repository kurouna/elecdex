# ELECLANCE's music (docs/elec16-eleclance.md section 7), for the game kit's MML
# (docs/elec16-play.md section 10). Channels 0-11 are the music's; 12-15 the effects'.
#
# Layout of the band in every song:
#   C0 lead, C1 its echo, C2 harmony, C3 bass, C4 arpeggio,
#   C5 kick, C6 snare, C7 hats, C11 the OVERDRIVE layer (kept quiet until called)

# ----------------------------------------------------------------------------------------
song stage
# 150 BPM: a sixteenth is six frames. A minor, the climb F-G-Am; the last chorus a tone up.
tempo 6
inst lead  wave=sq25 vol=13 env=5/250/10/160 vib=3,5 pan=5
inst harm  wave=sq50 vol=8  env=5/250/9/160 pan=10
inst bass  wave=saw  vol=12 env=2/120/8/40
inst arp   wave=tri  vol=9  env=2/80/3/40 pan=11
inst kick  wave=tri  vol=15 env=0/120/0/40 drop=2
inst snare wave=noise vol=11 env=0/160/0/120 pan=7
inst hat   wave=noise vol=5 env=0/20/0/20 pan=9
inst over  wave=sq12 vol=8  env=2/80/5/60 pan=3

define bA  = l16 [o2 a a > a < a]4
define bF  = l16 [o2 f f > f < f]4
define bG  = l16 [o2 g g > g < g]4
define bE  = l16 [o2 e e > e < e]4
define bD  = l16 [o2 d d > d < d]4
define bBb = l16 [o2 b- b- > b- < b-]4
define bC  = l16 [o3 c c > c < c]4
define bGs = l16 [o2 g+ g+ > g+ < g+]4

define arAm = l16 [o4 a > c e a]4
define arF  = l16 [o4 f a > c f]4
define arG  = l16 [o4 g b > d g]4
define arEm = l16 [o4 e g b > e]4
define arE  = l16 [o4 e g+ b > e]4
define arDm = l16 [o4 d f a > d]4
define arBb = l16 [o4 b- > d f b-]4
define arC  = l16 [o5 c e g > c]4

define kick  = o4 c16 r16 r8 r4 c16 r16 c16 r16 r4
define snare = r4 o7 c4 r4 c4
define fill  = r4 o7 c4 r4 c16 c16 c16 c16
define hats  = [o9 c8]8

# The intro: drums alone, then bass and arpeggio, four bars; the loop starts at section A.
C0: @lead v13 r1 r1 r1 r1
C2: @harm v9 r1 r1 r1 r1
C3: @bass v12 r1 r1 $bA $bA
C4: @arp v8 r1 r1 $arAm $arAm
C5: @kick $kick $kick $kick $kick
C6: @snare r1 r1 $snare $fill
C7: @hat r1 $hats $hats $hats
C11: @over v8 r1 r1 r1 r1

# A: the theme, on Am F G Em | Am F G E.
C0: L o5 e4. d8 c8 d8 e4 | f4 a4 > c4 < a8 g8 | g4. a8 b8 > d8 < b4 | e2^8 r8 e8 g8
C0: a4 > c8 < b8 a4 e4 | f4 g8 a8 > c4 < a4 | b4 > d8 c8 < b4 g4 | g+2 e4 r4
C2: L r1 r1 r1 r1 r1 r1 r1 r1
C3: L $bA $bF $bG $bE $bA $bF $bG $bE
C4: L $arAm $arF $arG $arEm $arAm $arF $arG $arE
C5: L [$kick]8
C6: L [$snare]7 $fill
C7: L [$hats]8
C11: L $arAm $arF $arG $arEm $arAm $arF $arG $arE

# B: the tension, on Dm Am Bb F | Dm E F G, up an octave and pushed off the beat.
C0: o6 d8. d16 c8 d8 f4 e4 | e8. c16 < a8 > c8 e4 c4 | d8. d16 c8 d8 f4 g4 | a2 g4 f4
C0: f8. e16 d8 f8 a4 g4 | g+8. f16 e8 g+8 b4 g+4 | a4 g8 f8 g4 a4 | b4 > c4 d4 e4
C2: o5 a2 f2 | a2 e2 | b-2 > d2 < | a2 > c2 < | a2 > d2 < | b2 g+2 | a2 > c2 < | > d2 e2 <
C3: $bD $bA $bBb $bF $bD $bGs $bF $bG
C4: $arDm $arAm $arBb $arF $arDm $arE $arF $arG
C5: [$kick]8
C6: [$snare]6 $fill $fill
C7: [$hats]8
C11: $arDm $arAm $arBb $arF $arDm $arE $arF $arG

# The chorus: the sky opens on F G Am, long notes over the running bass.
define chLead = o6 c2 < a4 > c4 | d2 < b4 > d4 | e2. d8 c8 | e1 | f2 e4 d4 | d2 c4 < b4 | > c4 < g4 g+4 b4 | a1
define chHarm = o5 a2 f4 a4 | b2 g4 b4 | > c2. < b8 a8 | > c1 < | a2 > c4 < a4 | b2 a4 g4 | e4 e4 e4 g+4 | e1
define chBass = $bF $bG $bA $bA $bF $bG $bC $bE
define chArp  = $arF $arG $arAm $arAm $arF $arG $arC $arE
C0: $chLead
C2: $chHarm
C3: $chBass
C4: $chArp
C5: [$kick]8
C6: [$snare]7 $fill
C7: [$hats]8
C11: $chArp

# The bridge: rising, Dm E F G.
C0: o5 a4 > d4 f4 a4 | g+2 e2 | a4 > c4 f4 a4 | g2 f2
C2: o5 f1 | e1 | f1 | g1
C3: $bD $bE $bF $bG
C4: $arDm $arE $arF $arG
C5: [$kick]4
C6: $snare $snare $fill $fill
C7: [$hats]4
C11: $arDm $arE $arF $arG

# The last chorus a whole tone up, then back to A.
C0: k2 $chLead k0
C2: k2 $chHarm k0
C3: k2 $chBass k0
C4: k2 $chArp k0
C5: [$kick]8
C6: [$snare]7 $fill
C7: [$hats]8
C11: k2 $chArp k0

echo C1 = C0 delay 12 vol -6 pan 11

# ----------------------------------------------------------------------------------------
song boss
# 180 BPM: a sixteenth is five frames. E minor against F: a half step that will not settle;
# the bass grinds chromatically, the lead jabs a short figure and climbs.
tempo 5
inst lead  wave=sq25 vol=13 env=2/160/9/100 vib=2,6 pan=5
inst stab  wave=sq50 vol=9  env=0/80/4/60 pan=10
inst bass  wave=saw  vol=13 env=0/80/9/30
inst arp   wave=tri  vol=9  env=0/60/2/30 pan=11
inst kick  wave=tri  vol=15 env=0/120/0/40 drop=2
inst snare wave=noise vol=12 env=0/160/0/120 pan=7
inst hat   wave=noise vol=5 env=0/20/0/20 pan=9
inst over  wave=sq12 vol=9  env=0/60/5/40 pan=3

define grind  = l16 o2 e e > e < e f f > f < f e e > e < e d+ d+ > d+ < d+
define grind2 = l16 o2 c c > c < c c+ c+ > c+ < c+ d d > d < d d+ d+ > d+ < d+
define kick  = o4 c16 r16 c16 r16 r4 c16 r16 c16 r16 r4
define snare = r4 o7 c4 r4 c4
define fill  = r4 o7 c8 c8 c16 c16 c16 c16 c16 c16 c16 c16
define hats  = [o9 c16]16
define jab   = l16 o5 e r e g r e a8 g8 f8 e8 r8
define jab2  = l16 o5 e r e g r e b8 a8 g8 f8 r8
define climb = l8 o5 b > c d d+ e f f+ g

C0: @lead L $jab $jab2 $jab $climb | o6 e2 d+2 | e4. f8 e4 d4 | c2 < b2 | > c4 < b4 a4 g+4
C2: @stab L r1 r1 r1 r1 | l8 [o5 b r b r g r g r]2 | [o5 a r a r f r f r]2
C3: @bass L $grind $grind $grind $grind2 $grind $grind $grind2 $grind2
C4: @arp L [l16 o5 e g b > e < b g e g]2 [l16 o5 f a > c f c < a f a]2 [l16 o5 e g b > e < b g e g]2 [l16 o5 d+ f+ a b a f+ d+ f+]2
C4: [l16 o5 e g b > e < b g e g]2 [l16 o5 f a > c f c < a f a]2 [l16 o5 c e g > c < g e c e]2 [l16 o5 b > d+ f+ b f+ d+ < b > d+]2
C5: @kick L [$kick]8
C6: @snare L [$snare]3 $fill [$snare]3 $fill
C7: @hat L [$hats]8
C11: @over L [l16 o6 e b > e < b]8 [l16 o6 f > c f c <]8 [l16 o6 e b > e < b]8 [l16 o6 d+ a+ > d+ < a+]8

echo C1 = C0 delay 10 vol -6 pan 11

# ----------------------------------------------------------------------------------------
song title
# Slow and wide: a sixteenth is eight frames (112 BPM). Am F C G | Am F G E; a pad and a
# long melody over a soft arpeggio, so the title breathes before the stage runs.
tempo 8
inst lead wave=sq25 vol=12 env=40/400/11/400 vib=4,4 pan=5
inst pad  wave=sq50 vol=6  env=120/800/12/800 pan=10
inst arp  wave=tri  vol=8  env=2/120/3/80 pan=11
inst bass wave=tri  vol=12 env=10/400/10/200

C0: @lead L o5 e2 a2 | g2 f4 e4 | g2. e4 | d1 | e2 a2 | > c2 < b4 a4 | b2 > d4 c4 | < b1
C2: @pad L o4 a1 f1 e1 d1 a1 f1 g1 g+1
C3: @bass L o2 a1 f1 > c1 < g1 a1 f1 g1 e1
C4: @arp L l16 [o4 a > c e c]4 [o4 f a > c < a]4 [o5 c e g e]4 [o4 g b > d < b]4
C4: l16 [o4 a > c e c]4 [o4 f a > c < a]4 [o4 g b > d < b]4 [o4 e g+ b g+]4
echo C1 = C0 delay 16 vol -6 pan 11

# ----------------------------------------------------------------------------------------
song clear
# The stage cleared: from A minor up into its major, once, ringing out.
tempo 6
inst lead wave=sq25 vol=13 env=2/400/10/600 pan=6
inst harm wave=sq50 vol=9  env=2/400/10/600 pan=10
inst bass wave=tri  vol=12 env=2/400/10/600
inst arp  wave=tri  vol=8  env=2/80/3/40
C0: @lead o5 l16 e a > c e a4 g8 e8 | f4 g4 a2^2
C2: @harm o5 l16 c e a > c e4 d8 c8 | c4 d4 c+2^2
C3: @bass o2 a2 f4 g4 | a1^2
C4: @arp l16 [o4 a > c e a]2 [o4 f a > c f]1 [o4 g b > d g]1 | [o4 a > c+ e a]6

# ----------------------------------------------------------------------------------------
song over
# The game's end: falling, quiet.
tempo 8
inst lead wave=sq50 vol=11 env=10/600/8/800 vib=3,3 pan=6
inst bass wave=tri  vol=11 env=10/600/8/800
C0: @lead o5 e4 d4 c4 < b4 | a4 g4 e2 | a1
C3: @bass o2 a2 f2 | d2 e2 | a1

# ----------------------------------------------------------------------------------------
song entry
# The best five: a calm loop while the letters are chosen.
tempo 8
inst lead wave=tri  vol=11 env=5/300/9/300 vib=2,4 pan=6
inst arp  wave=sq12 vol=6  env=2/80/3/60 pan=10
inst bass wave=tri  vol=10 env=10/400/10/200
C0: @lead L o5 c4 e4 g4 e4 | f4 a4 g2 | e4 g4 > c4 < b4 | a2 g2
C4: @arp L l16 [o4 c e g e]4 [o4 f a > c < a]4 [o4 e g > c < g]4 [o4 f a > c < a]2 [o4 g b > d < b]2
C3: @bass L o2 c1 f1 c1 f2 g2

# ----------------------------------------------------------------------------------------
song extend
# An extra ship: a quick run up, on an effects channel so the music goes on.
tempo 2
inst ring wave=sq25 vol=12 env=0/120/8/200 pan=8
C15: @ring o5 l32 c e g > c e g > c e g > c8
