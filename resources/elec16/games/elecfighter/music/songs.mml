# ELECFIGHTER's music (docs/elec16-elecfighter-design.md 9), for the game kit's MML
# (docs/elec16-kit.md 6). Channels 0-11 are the music's; 12-15 the effects' (sfx.mml).
# Written for this game from nothing but the genre's common ways (a quick tempo, a minor key,
# a pumping bass); sharps are written with + (a hash after a space is a comment).
#
# The band in the looping songs, each channel whole bars and every channel of a song the same
# length (a test holds them in step):
#   C0 lead, C1 its echo, C2 pad, C3 bass, C4 arpeggio, C5 kick, C6 snare, C7 hats
# The chords move by transposing one figure (k: semitones up from C).

# ----------------------------------------------------------------------------------------
song title
# The title: 128 BPM, A minor, Am F C G | Am F G E. Slow enough to wait to, the lead calling.
tempo 7
inst lead  wave=sq25 vol=12 env=2/220/9/120 vib=2,6 pan=6
inst pad   wave=tri  vol=8  env=60/500/10/300 pan=9
inst bass  wave=tri  vol=14 env=0/160/9/30
inst arp   wave=sq12 vol=5  env=0/60/2/30 pan=10
inst kick  wave=tri  vol=15 env=0/100/0/30 drop=2
inst snare wave=noise vol=9 env=0/120/0/80 pan=7
inst hat   wave=noise vol=4 env=0/20/0/20 pan=9

define pump = l8 [o2 c > c <]4
define maj  = l16 [o4 c e g > c <]4
define min  = l16 [o4 c e- g > c <]4
define kick = o3 l4 c c c c
define snr  = o7 r4 c4 r4 c4
define hats = o9 [r8 c8]4

C0: @lead v12 L o5 a4 e8 a8 > c4 < b8 a8 | o5 f4. e8 c4 d4 | o5 e4 g8 e8 c4 e4 | o5 d2. r4
C0: o5 a4 > c8 < a8 e4 a4 | o5 f8 g8 a8 > c8 < b4 a4 | o5 g4 b8 > d8 < b4 g4 | o5 g+2 e2
C2: @pad L o4 e1 | o4 f1 | o4 g1 | o4 g1 | o4 e1 | o4 f1 | o4 d1 | o4 e1
C3: @bass L k9 $pump k5 $pump k0 $pump k7 $pump k9 $pump k5 $pump k7 $pump k4 $pump
C4: @arp L k9 $min k5 $maj k0 $maj k7 $maj k9 $min k5 $maj k7 $maj k4 $maj
C5: @kick L [$kick]8
C6: @snare L [$snr]8
C7: @hat L [$hats]8
echo C1 = C0 delay 7 vol -6 pan 11

# ----------------------------------------------------------------------------------------
song select
# Choosing a fighter: 150 BPM, D minor, Dm Bb C A, a short figure that waits.
tempo 6
inst lead  wave=sq50 vol=10 env=2/160/7/80 vib=2,7 pan=6
inst bass  wave=tri  vol=13 env=0/160/9/30
inst arp   wave=sq12 vol=5  env=0/60/2/30 pan=10
inst kick  wave=tri  vol=14 env=0/100/0/30 drop=2
inst hat   wave=noise vol=4 env=0/20/0/20 pan=9

define pump = l8 [o2 c > c <]4
define maj  = l16 [o4 c e g > c <]4
define min  = l16 [o4 c e- g > c <]4
define kick = o3 c4 r8 c8 c4 r4
define hats = o9 [r8 c8]4

C0: @lead L o5 d8 f8 a8 f8 d4 r4 | o5 d8 f8 b-8 f8 d4 r4 | o5 e8 g8 > c8 < g8 e4 r4 | o5 c+8 e8 a8 e8 c+2
C3: @bass L k2 $pump k10 $pump k0 $pump k9 $pump
C4: @arp L k2 $min k10 $maj k0 $maj k9 $maj
C5: @kick L [$kick]4
C7: @hat L [$hats]4
echo C1 = C0 delay 6 vol -6 pan 11

# ----------------------------------------------------------------------------------------
song fight
# The fight (GRID's): 180 BPM, E minor, Em C D B twice, the lead climbing the second time.
tempo 5
inst lead  wave=sq25 vol=12 env=0/140/8/60 vib=3,7 pan=6
inst pad   wave=saw  vol=6  env=20/300/8/200 pan=9
inst bass  wave=saw  vol=11 env=0/120/9/30
inst arp   wave=sq12 vol=5  env=0/40/2/20 pan=10
inst kick  wave=tri  vol=15 env=0/100/0/30 drop=2
inst snare wave=noise vol=10 env=0/120/0/80 pan=7
inst hat   wave=noise vol=4 env=0/20/0/20 pan=9

define pump = l8 [o2 c > c <]4
define maj  = l16 [o4 c e g > c <]4
define min  = l16 [o4 c e- g > c <]4
define kick = o3 c8 c8 r8 c8 c8 r8 c8 r8
define snr  = o7 r4 c4 r4 c4
define fill = o7 r4 c4 c8 c16 c16 c8 c8
define hats = o9 [c16]16

C0: @lead L o5 e8 e8 g8 e8 b8 a8 g8 f+8 | o5 e8 e8 g8 e8 > c8 < b8 a8 g8 | o5 f+8 f+8 a8 f+8 > d8 c8 < b8 a8 | o5 b4 a8 g8 f+4 d+4
C0: o6 e4 d8 c8 < b4 g4 | o5 c8 e8 g8 > c8 < b4 g4 | o5 a8 b8 > c8 d8 < a4 f+4 | o5 b2 > d+4 < b4
C2: @pad L o4 b1 | o4 g1 | o4 a1 | o4 f+1 | o4 b1 | o4 g1 | o4 a1 | o4 f+1
C3: @bass L k4 $pump k0 $pump k2 $pump k11 $pump k4 $pump k0 $pump k2 $pump k11 $pump
C4: @arp L k4 $min k0 $maj k2 $maj k11 $maj k4 $min k0 $maj k2 $maj k11 $maj
C5: @kick L [$kick]8
C6: @snare L [$snr]7 $fill
C7: @hat L [$hats]8
echo C1 = C0 delay 5 vol -6 pan 11

# ----------------------------------------------------------------------------------------
song win
# A match won: two bars, C major, up and held. Not looped.
tempo 6
inst lead  wave=sq25 vol=12 env=0/200/10/300 vib=2,6 pan=6
inst pad   wave=tri  vol=9  env=10/300/10/300 pan=9
inst bass  wave=tri  vol=14 env=0/200/10/200
inst kick  wave=tri  vol=15 env=0/100/0/30 drop=2

C0: @lead o5 l16 c e g > c < g > c e g > c2 | o6 c1
C2: @pad o4 l8 e g e g e g e g | o4 g1
C3: @bass o2 c4 g4 c4 g4 | o2 c1
C5: @kick o3 c4 c4 c4 c4 | o3 c4 r4 r2

# ----------------------------------------------------------------------------------------
song lose
# A match lost: two slow bars falling in A minor. Not looped.
tempo 8
inst lead  wave=sq50 vol=10 env=4/300/8/400 vib=4,5 pan=6
inst pad   wave=tri  vol=8  env=40/400/9/400 pan=9
inst bass  wave=tri  vol=12 env=0/300/9/300

C0: @lead o5 e4 d+4 d4 c+4 | o5 c2 < a2
C2: @pad o4 a2 g+2 | o4 e1
C3: @bass o2 a1 | o2 a1

# ----------------------------------------------------------------------------------------
song clear
# SYSTEM CLEAR: 150 BPM, C major, C G Am F | C G F G, the whole band, looped while the record shows.
tempo 6
inst lead  wave=sq50 vol=12 env=2/200/9/100 vib=2,6 pan=6
inst pad   wave=tri  vol=8  env=30/400/10/300 pan=9
inst bass  wave=tri  vol=14 env=0/160/9/30
inst arp   wave=sq12 vol=5  env=0/60/2/30 pan=10
inst kick  wave=tri  vol=15 env=0/100/0/30 drop=2
inst snare wave=noise vol=9 env=0/120/0/80 pan=7
inst hat   wave=noise vol=4 env=0/20/0/20 pan=9

define pump = l8 [o2 c > c <]4
define maj  = l16 [o4 c e g > c <]4
define min  = l16 [o4 c e- g > c <]4
define kick = o3 l4 c c c c
define snr  = o7 r4 c4 r4 c4
define hats = o9 [r8 c8]4

C0: @lead L o5 e4 g4 > c4 < g4 | o5 d4 g4 b4 g4 | o5 c4 e4 a4 e4 | o5 f4 a4 > c2 <
C0: o6 c4 < b8 a8 g4 e4 | o5 d4 g8 a8 b4 g4 | o5 a4 > c8 d8 < a4 f4 | o5 g2 b4 > d4
C2: @pad L o4 g1 | o4 g1 | o4 a1 | o4 a1 | o4 g1 | o4 g1 | o4 a1 | o4 b1
C3: @bass L k0 $pump k7 $pump k9 $pump k5 $pump k0 $pump k7 $pump k5 $pump k7 $pump
C4: @arp L k0 $maj k7 $maj k9 $min k5 $maj k0 $maj k7 $maj k5 $maj k7 $maj
C5: @kick L [$kick]8
C6: @snare L [$snr]8
C7: @hat L [$hats]8
echo C1 = C0 delay 6 vol -6 pan 11
