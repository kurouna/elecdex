10 REM UNITS: FROM ONE UNIT TO ANOTHER; 0 ENDS
20 PRINT "1 IN>CM 2 MI>KM 3 LB>KG 4 F>C"
30 INPUT "WHICH";K:IF K=0 THEN END
40 IF K<1 OR K>4 THEN 30
50 INPUT "VALUE";X
60 ON K GOSUB 100,110,120,130
70 GOTO 30
100 PRINT X*2.54;"CM":RETURN
110 PRINT X*1.609344;"KM":RETURN
120 PRINT X*0.45359237;"KG":RETURN
130 PRINT (X-32)*5/9;"C":RETURN
