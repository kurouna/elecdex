10 REM CHAT: TALK WITH THE AI THROUGH LINK
20 DIM Q$*78,A$*255,T$(10)*7
30 FOR I=0 TO 10:READ T$(I):NEXT I
40 DATA NORMAL,TUTOR,BASIC,QUIZ,STORY,POET,FORTUNE,DICT,TRANS,SEARCH,WEATHER
50 W=INT(LCDW/6)
60 ASK NEW
100 REM THE TYPES, AS MANY TO A ROW AS FIT
110 CLS:PRINT "CHAT: CHOOSE A TYPE"
120 C=0
130 FOR I=0 TO 10
140 IF C+12>W THEN PRINT:C=0
150 PRINT LEFT$(RIGHT$(" "+STR$(I),2)+" "+T$(I)+"          ",12);
160 C=C+12
170 NEXT I
180 PRINT
190 INPUT "TYPE";T
200 IF T<0 OR T>10 OR T<>INT(T) THEN 190
210 ASK TYPE T
300 REM TALK: AN EMPTY LINE OPENS THE MENU
310 CLS:PRINT T$(T);": ENTER ALONE=MENU"
320 Q$=""
330 INPUT Q$
340 IF Q$="" THEN 600
350 ASK Q$,A$,S
355 IF S<>0 THEN GOSUB 700:GOTO 320
360 GOSUB 400
370 GOTO 320
400 REM THE ANSWER, TYPED OUT, WRAPPED AT THE SPACES
410 C=0:I=1:L=LEN(A$)
420 IF I>L THEN 520
430 J=I
440 IF J>L THEN 470
450 IF MID$(A$,J,1)=" " THEN 470
460 J=J+1:GOTO 440
470 N=J-I
480 IF C>0 AND C+N>W THEN PRINT:C=0
490 FOR K=I TO J-1:PRINT MID$(A$,K,1);:WAIT 1:NEXT K
500 C=C+N:C=C-INT(C/W)*W
510 IF J<L AND C>0 THEN PRINT " ";:C=C+1:IF C>=W THEN C=0
515 I=J+1:GOTO 420
520 IF C>0 THEN PRINT
530 RETURN
600 REM THE MENU
610 PRINT "1 TYPE  2 NEW TALK  3 END"
620 INPUT "MENU";M
630 IF M=1 THEN 110
640 IF M=2 THEN ASK NEW:GOTO 310
650 IF M=3 THEN CLS:PRINT "CHAT ENDED":END
660 GOTO 310
700 REM NO ANSWER: WHY, AND ON TO THE NEXT QUESTION
710 IF S=2 THEN PRINT "LINK OFF: TURN ON IN LINK":RETURN
720 PRINT "NO ANSWER: SEE LINK":RETURN
