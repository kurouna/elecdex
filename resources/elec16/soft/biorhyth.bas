10 REM BIORHYTHM: THREE CYCLES FROM A BIRTH DATE TO TODAY
20 INPUT "BIRTH YEAR";Y:INPUT "MONTH";M:INPUT "DAY";D
30 GOSUB 200:B=N
40 Y=VAL(LEFT$(DATE$,4)):M=VAL(MID$(DATE$,6,2)):D=VAL(RIGHT$(DATE$,2))
50 GOSUB 200:T=N-B
60 PRINT "DAYS LIVED";T
70 RAD
80 PRINT "PHYSICAL  ";INT(SIN(2*PI*T/23)*100);"%"
90 PRINT "EMOTIONAL ";INT(SIN(2*PI*T/28)*100);"%"
100 PRINT "INTELLECT ";INT(SIN(2*PI*T/33)*100);"%"
110 DEG:END
200 REM THE DAY NUMBER N OF THE DATE Y, M, D
210 IF M<3 THEN Y=Y-1:M=M+12
220 N=INT(365.25*Y)+INT(30.6001*(M+1))+D
230 RETURN
