10 REM LANDER: LAND ON THE MOON, BURNING 0 TO 30 UNITS A SECOND
20 H=500:V=50:F=250:T=0
30 PRINT "T";T;"H";INT(H);"V";INT(V);"F";F
40 INPUT "BURN";B:IF B<0 OR B>30 THEN 40
50 IF B>F THEN B=F
60 F=F-B:V=V+5-B/2:H=H-V:T=T+1
70 IF H>0 THEN 30
80 IF V<5 THEN PRINT "LANDED SAFELY IN ";T;"SECONDS":END
90 PRINT "CRASHED AT ";INT(V);"M/S"
