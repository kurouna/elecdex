10 REM CANNON: HIT THE TARGET; ARROWS AIM, SPACE FIRES, Q ENDS
20 CLS:W=LCDW:H=LCDH:DEG:S=0:A=45:R=INT(H/16)+1:L=INT(H/5):V=4:G=16/W
30 FOR N=1 TO 5
40 T=INT(W/2)+R+RND(INT(W/2)-2*R-2):C=H-R-1
50 CLS:LINE (0,H-1)-(W-1,H-1):CIRCLE (T,C),R,F:GOSUB 400
60 LOCATE 0,0:PRINT "SHOT";N;"ANGLE";A;"HITS";S
70 WAIT 1:K$=INKEY$:IF K$="" THEN 70
80 IF K$="Q" OR K$="q" THEN CLS:END
90 IF K$=" " THEN 200
100 D=0:IF K$=CHR$(30) THEN D=5
110 IF K$=CHR$(31) THEN D=-5
120 IF K$=CHR$(29) THEN D=1
130 IF K$=CHR$(28) THEN D=-1
140 IF D=0 OR A+D<1 OR A+D>89 THEN 70
150 GOSUB 400:A=A+D:GOSUB 400:GOTO 60
200 BEEP 440,30:X=0:Y=H-2:P=COS(A)*V:Q=-SIN(A)*V
210 X=X+P:Q=Q+G:Y=Y+Q:PSET X,Y:WAIT 1
220 IF (X-T)*(X-T)+(Y-C)*(Y-C)<=R*R THEN 260
230 IF X<W AND Y<H-1 THEN 210
240 BEEP 220,100:GOTO 270
260 S=S+1:BEEP 1760,100:LOCATE 0,1:PRINT "HIT!"
270 WAIT 32
280 NEXT N
290 CLS:PRINT "HITS ";S;"OF 5"
300 END
400 REM THE BARREL, TURNED OVER DOT BY DOT: ONCE DRAWS IT, AGAIN TAKES IT AWAY
410 IF A>45 THEN 440
420 FOR I=1 TO L:PSET I,H-2-INT(I*TAN(A)+.5),X:NEXT I
430 RETURN
440 FOR I=1 TO L:PSET INT(I/TAN(A)+.5),H-2-I,X:NEXT I
450 RETURN
