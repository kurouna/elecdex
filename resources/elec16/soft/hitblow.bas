10 REM HIT&BLOW: GUESS THREE DIFFERENT DIGITS
20 DIM S(2)
30 S(0)=RND 10-1
40 S(1)=RND 10-1:IF S(1)=S(0) THEN 40
50 S(2)=RND 10-1:IF S(2)=S(0) OR S(2)=S(1) THEN 50
60 T=0
70 INPUT "GUESS";G$:IF LEN(G$)<>3 THEN 70
80 T=T+1:H=0:B=0
90 FOR I=0 TO 2:FOR J=0 TO 2
100 IF VAL(MID$(G$,I+1,1))<>S(J) THEN 120
110 IF I=J THEN H=H+1 ELSE B=B+1
120 NEXT J:NEXT I
130 PRINT H;"HIT ";B;"BLOW"
140 IF H<3 THEN 70
150 PRINT "GOT IT IN ";T;"TRIES"
